# Dependencies — werden im Build per `pnpm install` frisch geholt
**/node_modules

# Git
.git
.gitignore

# Build-Outputs — werden im Build neu erzeugt
**/dist
**/.generated

# Secrets — niemals ins Image backen (Coolify injiziert Env-Vars zur Laufzeit)
**/.env
**/.env.*
!**/.env.example

# Docs & Tooling — für den Build nicht nötig
**/*.md
.claude
.vscode
.idea

# Tests / E2E
test-results
playwright-report
**/*.spec.ts
**/*.test.ts

# Lokale Assets, die nicht importiert werden
attached_assets

# OS-Artefakte
.DS_Store
**/*.log
