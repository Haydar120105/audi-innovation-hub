# ── .env.production.example ──────────────────────────────────────────────────
# Copy this file to .env.production and fill in your real values.
# .env.production is in .gitignore and must NEVER be committed.

# ── API Server (runtime) ─────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# Neon PostgreSQL (external) — copy from Neon console
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Department portal access key (choose any strong secret)
DEPARTMENT_WRITE_SECRET=REPLACE_ME_STRONG_SECRET

# Clerk Backend Keys — use LIVE keys (pk_live_..., sk_live_...) in production
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# ── Frontend (build-time, passed as Docker build arg) ────────────────────────
# Must match CLERK_PUBLISHABLE_KEY above.
# Changing this requires rebuilding the nginx image: docker compose build nginx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
